# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# News Provider (newsdata.io)
# Usada na rota /api/news
NEWSDATA_API_KEY=your_newsdata_api_key_here

# Anthropic — usada na automação do blog (npm run blog:draft). Recomendada.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini — usada no Resumidor de Texto e como fallback da automação do blog.
GEMINI_API_KEY=your_gemini_api_key_here

# (Opcional) Modelo usado pela automação do blog. Padrão: claude-sonnet-4-6
# BLOG_MODEL=claude-sonnet-4-6
# (Opcional) Modelo de imagem (capa). Padrão: imagen-4.0-fast-generate-001
# BLOG_IMAGE_MODEL=imagen-4.0-fast-generate-001
# (Opcional) Imagem padrão quando a capa não é gerada. Padrão: /artigo_image1.png
# BLOG_DEFAULT_IMAGE=/artigo_image1.png

# === Automação na Vercel (cron + painel /admin) ===
# Criado automaticamente ao conectar o Vercel Blob (Storage -> Create -> Blob).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# Senha do painel /admin (você escolhe).
ADMIN_PASSWORD=defina_uma_senha_forte
# (Opcional) Protege a rota do cron. A Vercel envia este valor automaticamente.
# CRON_SECRET=um_valor_aleatorio
